<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><Button android:id="@+id/cell_6" style="@style/WidgetKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Square 7"/><Button android:id="@+id/cell_7" style="@style/WidgetKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Square 8"/><Button android:id="@+id/cell_8" style="@style/WidgetKey" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:contentDescription="Square 9"/></LinearLayout>
<Button android:id="@+id/new_game" style="@style/WidgetKey" android:layout_width="match_parent" android:layout_height="38dp" android:text="New round" android:textSize="14sp"/>
</LinearLayout>
